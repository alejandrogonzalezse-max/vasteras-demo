		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"@fontsource/silkscreen": "^5.3.0",
		"@fontsource/vt323": "^5.3.0",
		"leaflet": "^1.9.4",
		"qrcode-generator": "^2.0.4"
	}
